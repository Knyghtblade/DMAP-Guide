<?xml version="1.0" encoding="utf-8" ?>
<!-- A character on the Cast & Characters page: the full record (the desktop's roster card). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:DmapShared.Models;assembly=DmapShared"
             xmlns:c="clr-namespace:DmapAndroid.Controls"
             x:Class="DmapAndroid.Controls.RosterCard"
             x:DataType="m:CastMember">
    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
        <Grid ColumnDefinitions="112,*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="6">
                <c:Portrait ImagePath="{Binding ImagePath}" Size="104"/>
                <c:AddButton Text="Picture…" Margin="14,0,0,0" HorizontalOptions="Start" Clicked="OnChoosePortrait"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <c:InkEntry Text="{Binding CharacterName}" Placeholder="Character name" FontFamily="DmapDisplay"
                            FontSize="19" TextColor="{StaticResource RubricColor}"/>
                <c:InkEntry Text="{Binding CharacterSummary}" Placeholder="Race · Class · Level" FontFamily="DmapBodyItalic"
                            FontSize="14" TextColor="{StaticResource InkSoftColor}"/>

                <Label Text="PLAYED BY" Style="{StaticResource FieldLabel}" Margin="2,8,0,0"/>
                <c:InkEntry Text="{Binding PlayerName}" Placeholder="Cast member's real name" FontAttributes="Bold"/>

                <Label Text="BIO" Style="{StaticResource FieldLabel}" Margin="2,8,0,0"/>
                <c:InkEditor Text="{Binding CharacterDescription}" Placeholder="The character's story: backstory, personality, look…"/>

                <Label Text="{Binding Appearances}" FontFamily="DmapBodyItalic" FontSize="13" TextColor="{StaticResource InkFadedColor}"
                       Margin="3,8,0,0"/>
            </VerticalStackLayout>

            <c:RemoveButton Grid.Column="2" Clicked="OnRemove"/>
        </Grid>
    </Border>
</ContentView>

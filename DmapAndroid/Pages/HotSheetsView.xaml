<?xml version="1.0" encoding="utf-8" ?>
<!-- An episode's Hot Sheets page (the desktop's Hot Sheets): the words read in from the PDF. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:DmapShared.Models;assembly=DmapShared"
             xmlns:c="clr-namespace:DmapAndroid.Controls"
             x:Class="DmapAndroid.Pages.HotSheetsView"
             x:DataType="m:HotSheetsPage">
    <VerticalStackLayout Spacing="2" Padding="2,0,6,24">
        <Label Style="{StaticResource PageKicker}">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding Episode.Campaign.DisplayName}"/>
                    <Span Text="  ›  "/>
                    <Span Text="{Binding Episode.DisplayName}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <Label Style="{StaticResource PageTitle}" Text="Hot Sheets"/>
        <Label Style="{StaticResource Flourish}"/>

        <Label Style="{StaticResource Body}" FontFamily="DmapBodyItalic" TextColor="{StaticResource InkSoftColor}" Margin="2,0,0,8"
               Text="The Hot Sheets for this episode, copied in from the PDF. Press Edit Page to add a PDF, correct the text, or clear it."/>

        <!-- Which PDF(s) it came from -->
        <Label Style="{StaticResource Body}" FontFamily="DmapBodyItalic" FontSize="13" TextColor="{StaticResource InkFadedColor}" Margin="2,0,0,8"
               Text="{Binding Episode.HotSheetsSource}"/>

        <HorizontalStackLayout Spacing="8" Margin="0,0,0,10">
            <c:AddButton Text="+ Add Hot Sheets PDF…" Clicked="OnAdd"/>
            <c:AddButton Text="✕ Clear Hot Sheets" Clicked="OnClear"/>
        </HorizontalStackLayout>

        <!-- One PDF for two episodes (502 & 503): say so, and offer to keep only this one's parts -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12,8" IsVisible="{Binding CoversOtherEpisodes}">
            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource Body}" FontSize="14" TextColor="{StaticResource RubricColor}" Text="{Binding OtherEpisodesNote}"/>
                <c:AddButton Text="{Binding KeepOnlyLabel}" HorizontalOptions="Start" Margin="0" Clicked="OnKeepOnly"/>
            </VerticalStackLayout>
        </Border>

        <!-- Laid out as in the PDF: title, bold lines, dividers and tables, all editable -->
        <c:HotSheetLayout IsVisible="{Binding Episode.HasHotSheetsLayout}"/>

        <!-- Hot Sheets added before the layout was kept: just their words -->
        <c:InkEditor Text="{Binding Episode.HotSheets}" Placeholder="No Hot Sheets yet. Press Edit Page, then + Add Hot Sheets PDF." MinimumHeightRequest="160"
                     IsVisible="{Binding Episode.HasHotSheetsLayout, Converter={StaticResource Not}}"/>

        <c:TomeButton Text="← Back to the episode" Margin="0,16,0,0" HorizontalOptions="Start" Clicked="OnBack"/>
    </VerticalStackLayout>
</ContentView>

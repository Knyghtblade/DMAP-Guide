<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DmapShared.ViewModels;assembly=DmapShared"
             xmlns:c="clr-namespace:DmapAndroid.Controls"
             x:Class="DmapAndroid.Pages.IntroductionView"
             x:DataType="vm:IntroductionViewModel">
    <VerticalStackLayout Spacing="2" Padding="2,0,6,24">
        <Label Style="{StaticResource PageKicker}" Text="{Binding Main.Data.ShowName}"/>
        <Label Style="{StaticResource PageTitle}" Text="Introduction"/>
        <Label Text="What is DMAP?" FontFamily="DmapHeading" FontSize="17" TextColor="{StaticResource InkSoftColor}"/>
        <Label Style="{StaticResource Flourish}"/>

        <c:InkEditor Text="{Binding Main.Data.Introduction}" Placeholder="No introduction yet. Press Edit Page to write one."
                     MinimumHeightRequest="240"/>
    </VerticalStackLayout>
</ContentView>

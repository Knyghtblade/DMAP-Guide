<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:DmapShared.Models;assembly=DmapShared"
             xmlns:c="clr-namespace:DmapAndroid.Controls"
             x:Class="DmapAndroid.Pages.EpisodeView"
             x:DataType="m:Episode">
    <VerticalStackLayout Spacing="2" Padding="2,0,6,24">
        <Label Style="{StaticResource PageKicker}" Text="{Binding Campaign.DisplayName}"/>

        <HorizontalStackLayout Spacing="4">
            <Label Text="EPISODE" Style="{StaticResource FieldLabel}" FontSize="13" VerticalOptions="Center"/>
            <c:InkEntry Text="{Binding Number}" Keyboard="Numeric" MinimumWidthRequest="56" FontFamily="DmapHeading" FontSize="15"
                        FontAttributes="Bold" VerticalOptions="Center"/>
            <Border BackgroundColor="{Binding Status, Converter={StaticResource StatusColor}}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 9" Padding="9,2" VerticalOptions="Center">
                <Label Text="{Binding Status}" TextColor="#F7ECD2" FontFamily="DmapHeading" FontSize="10" FontAttributes="Bold"/>
            </Border>
        </HorizontalStackLayout>

        <c:InkEntry Style="{StaticResource TitleEntry}" Text="{Binding Title}" Placeholder="Untitled episode"/>
        <Label Style="{StaticResource Flourish}"/>

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="8">
            <VerticalStackLayout>
                <Label Text="DUNGEON MASTER" Style="{StaticResource FieldLabel}"/>
                <c:InkEntry Text="{Binding DungeonMaster}" Placeholder="Not set"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="DATE FILMED" Style="{StaticResource FieldLabel}"/>
                <c:DateField Date="{Binding DateFilmed}"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1">
                <Label Text="FILMING LOCATION" Style="{StaticResource FieldLabel}"/>
                <c:InkEntry Text="{Binding FilmingLocation}" Placeholder="Not set"/>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                <Label Text="RUNTIME" Style="{StaticResource FieldLabel}"/>
                <c:InkEntry Text="{Binding Runtime}" Placeholder="e.g. 1:42:30"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Synopsis -->
        <Label Text="Synopsis" Style="{StaticResource SectionHeader}" Margin="0,12,0,4"/>
        <c:InkEditor Text="{Binding Synopsis}" Placeholder="No synopsis yet."/>

        <!-- Cast -->
        <HorizontalStackLayout Style="{StaticResource SectionRow}">
            <Label Text="The Adventuring Party" Style="{StaticResource SectionHeader}"/>
            <c:TomeButton Text="Characters →" FontSize="10" Margin="12,0,0,0" VerticalOptions="Center" Clicked="OnOpenRoster"/>
        </HorizontalStackLayout>

        <!-- Edit mode: tick who's in this episode -->
        <c:EditOnly>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Text="WHO'S AT THE TABLE THIS EPISODE?" Style="{StaticResource FieldLabel}" Margin="2,0,0,4"/>
                    <Label Style="{StaticResource EmptyNote}"
                           Text="This campaign has no characters yet. Add them on the Characters page."
                           IsVisible="{Binding HasCampaignCharacters, Converter={StaticResource Not}}"/>
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CastChoices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:CastChoice">
                                <HorizontalStackLayout Margin="0,0,16,2">
                                    <CheckBox IsChecked="{Binding IsInEpisode}" VerticalOptions="Center"/>
                                    <Label VerticalOptions="Center" FontSize="14">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Member.CharacterName}" FontFamily="DmapBody" FontAttributes="Bold" TextColor="{StaticResource InkColor}"/>
                                                <Span Text="  "/>
                                                <Span Text="{Binding Member.PlayerName}" FontFamily="DmapBodyItalic" TextColor="{StaticResource InkFadedColor}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </c:EditOnly>

        <Label Style="{StaticResource EmptyNote}" Text="No cast chosen for this episode yet."
               IsVisible="{Binding CastMembers, Converter={StaticResource IsEmpty}}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CastMembers}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="m:CastMember">
                    <c:CastCard/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Guest cast -->
        <HorizontalStackLayout Style="{StaticResource SectionRow}">
            <Label Text="Guest Stars" Style="{StaticResource SectionHeader}"/>
            <c:AddButton Text="+ Add guest" Clicked="OnAddGuest"/>
        </HorizontalStackLayout>
        <Label Style="{StaticResource EmptyNote}" Text="No guest stars."
               IsVisible="{Binding GuestCast.Count, Converter={StaticResource IsEmpty}}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding GuestCast}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="m:CastMember">
                    <c:CastCard/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Key moments -->
        <HorizontalStackLayout Style="{StaticResource SectionRow}">
            <Label Text="Key Moments" Style="{StaticResource SectionHeader}"/>
            <c:AddButton Text="+ Add moment" Clicked="OnAddKeyMoment"/>
        </HorizontalStackLayout>
        <Label Style="{StaticResource EmptyNote}" Text="No key moments recorded."
               IsVisible="{Binding KeyMoments.Count, Converter={StaticResource IsEmpty}}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding KeyMoments}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="m:KeyMoment">
                    <Grid ColumnDefinitions="20,76,*,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                        <Label Text="✧" TextColor="{StaticResource GoldColor}" FontSize="15" Margin="0,8,0,0"/>
                        <c:InkEntry Grid.Column="1" Text="{Binding Timestamp}" Placeholder="Time" FontFamily="DmapHeading"
                                    FontSize="13" FontAttributes="Bold" TextColor="{StaticResource InkSoftColor}"/>
                        <c:InkEditor Grid.Column="2" Text="{Binding Description}" Placeholder="What happened?"/>
                        <c:RemoveButton Grid.Column="3" Clicked="OnRemoveKeyMoment" Margin="0,6,0,0"/>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Air dates -->
        <HorizontalStackLayout Style="{StaticResource SectionRow}">
            <Label Text="Air Dates" Style="{StaticResource SectionHeader}"/>
            <c:AddButton Text="+ Add air date" Clicked="OnAddAirDate"/>
        </HorizontalStackLayout>
        <Label Style="{StaticResource EmptyNote}" Text="No air dates set."
               IsVisible="{Binding AirDates.Count, Converter={StaticResource IsEmpty}}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AirDates}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="m:AirDate">
                    <Grid ColumnDefinitions="20,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                        <Label Text="☾" TextColor="{StaticResource GoldColor}" FontSize="15" Margin="0,6,0,0"/>
                        <c:DateField Grid.Column="1" Date="{Binding Date}"/>
                        <c:InkEntry Grid.Column="2" Text="{Binding Platform}" Placeholder="Network / platform"/>
                        <c:RemoveButton Grid.Column="3" Clicked="OnRemoveAirDate" Margin="0,4,0,0"/>
                        <c:InkEntry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Notes}" Placeholder="Notes"
                                    FontFamily="DmapBodyItalic" TextColor="{StaticResource InkSoftColor}"/>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Production notes -->
        <Label Text="Production Notes" Style="{StaticResource SectionHeader}" Margin="0,14,0,4"/>
        <c:InkEditor Text="{Binding ProductionNotes}" Placeholder="Planning notes, props, reminders, schedule changes…"/>
    </VerticalStackLayout>
</ContentView>

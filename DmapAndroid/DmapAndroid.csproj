<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DmapAndroid</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>DMAP Guide</ApplicationTitle>
    <ApplicationId>com.dmapguide.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiFont Include="..\DmapGuide\Fonts\*.ttf" Link="Resources\Fonts\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\DmapGuide\Assets\dmap-logo.png" LogicalName="DmapAndroid.Resources.dmaplogo.png" />
    <EmbeddedResource Include="..\DmapGuide\Assets\dragon-scales.jpg" LogicalName="DmapAndroid.Resources.dragonscales.jpg" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <ProjectReference Include="..\DmapDesktopClient\DmapDesktopClient.csproj" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything both apps share: the guide's pages, how they're stored
       (shared folder or shared server), and the view model behind every page. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DmapShared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmapTests" />
  </ItemGroup>

  <!-- The tome's artwork for the web copy: the app's own logo, and the dragon-scale binding made small. -->
  <ItemGroup>
    <EmbeddedResource Include="..\DmapGuide\Assets\dmap-logo.png" LogicalName="WebCopy.logo.png" />
    <EmbeddedResource Include="Export\Art\dragon-scales.jpg" LogicalName="WebCopy.dragon-scales.jpg" />
  </ItemGroup>
</Project>

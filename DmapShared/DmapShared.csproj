<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything both apps share: the guide's pages, how they're stored
       (shared folder or shared server), and the view model behind every page. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DmapShared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DmapTests" />
  </ItemGroup>
</Project>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:DmapShared.Models;assembly=DmapShared"
                    xmlns:vm="clr-namespace:DmapShared.ViewModels;assembly=DmapShared"
                    xmlns:svc="clr-namespace:DmapGuide.Services"
                    xmlns:ctl="clr-namespace:DmapGuide.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tome.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Text shown in place of a DatePicker when reading -->
    <Style x:Key="ViewOnlyBody" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Margin" Value="3,1"/>
        <Setter Property="Visibility"
                Value="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
    </Style>

    <Style x:Key="Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,20,14"/>
    </Style>

    <Style x:Key="EmptyNote" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource InkFadedBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="2,4,0,8"/>
    </Style>

    <Style x:Key="SectionRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>

    <!-- ============================================================
         CAST CARD (used for cast and guest cast)
    ============================================================ -->
    <DataTemplate x:Key="CastCard" DataType="{x:Type m:CastMember}">
        <Border Style="{StaticResource Card}" Width="350">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait in a gilded ring (drag it into place in edit mode) -->
                <StackPanel VerticalAlignment="Top">
                    <Grid Width="92" Height="92">
                        <Ellipse Fill="#33876A45"/>
                        <TextBlock Text="✦" FontSize="30" Foreground="{StaticResource InkFadedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SymbolFont}"/>
                        <ctl:PortraitView Source="{Binding ImagePath, Converter={StaticResource Image}, ConverterParameter=300}"
                                          OffsetX="{Binding ImageOffsetX}" OffsetY="{Binding ImageOffsetY}"
                                          CanDrag="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="2.5" IsHitTestVisible="False"/>
                        <Ellipse Stroke="{StaticResource InkSoftBrush}" StrokeThickness="0.8" Margin="4" Opacity="0.6"/>
                    </Grid>
                    <Button Style="{StaticResource AddButton}" Margin="0,6,0,0" HorizontalAlignment="Center"
                            Content="Picture…"
                            Command="{Binding DataContext.ChoosePortraitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,4,0">
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Character name" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="17"
                             Foreground="{StaticResource RubricBrush}"/>
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock Text="played by" Style="{StaticResource Body}" FontStyle="Italic" FontSize="15"
                                   Foreground="{StaticResource InkFadedBrush}" Margin="3,2,4,0" VerticalAlignment="Top"/>
                        <TextBox Style="{StaticResource InkBox}" Text="{Binding PlayerName}" Tag="Player" FontSize="16" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding CharacterSummary}" Tag="Race · Class · Level"
                             FontStyle="Italic" FontSize="15" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"/>
                    <Border CornerRadius="9" Padding="8,1" Margin="3,6,0,0" HorizontalAlignment="Left"
                            Background="{StaticResource ArcaneBrush}"
                            Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="GUEST CHARACTER" Foreground="#F7ECD2" FontFamily="{StaticResource HeadingFont}"
                                   FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource RemoveButton}"
                        Command="{Binding DataContext.RemoveCastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         GUEST CARD (episode page): a guest star from the Cast page
    ============================================================ -->
    <DataTemplate x:Key="GuestCard" DataType="{x:Type m:CastMember}">
        <Border Style="{StaticResource Card}" Width="350">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="92" Height="92" VerticalAlignment="Top">
                    <Ellipse Fill="#33876A45"/>
                    <TextBlock Text="✦" FontSize="30" Foreground="{StaticResource InkFadedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource SymbolFont}"/>
                    <ctl:PortraitView Source="{Binding ImagePath, Converter={StaticResource Image}, ConverterParameter=300}"
                                      OffsetX="{Binding ImageOffsetX, Mode=OneWay}" OffsetY="{Binding ImageOffsetY, Mode=OneWay}"/>
                    <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="2.5" IsHitTestVisible="False"/>
                    <Ellipse Stroke="{StaticResource InkSoftBrush}" StrokeThickness="0.8" Margin="4" Opacity="0.6" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,4,0">
                    <TextBlock Text="{Binding PlayerName}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="17"
                               Foreground="{StaticResource RubricBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CharacterSummary}" Style="{StaticResource Body}" FontStyle="Italic" FontSize="15"
                               Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"
                               Visibility="{Binding CharacterSummary, Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock Text="Details are kept on the Cast page" FontFamily="{StaticResource BodyFont}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="0,6,0,0"
                               Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource RemoveButton}" ToolTip="Take them out of this episode"
                        Command="{Binding DataContext.RemoveCastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         ROSTER CARD (Characters page): the full record for a character
    ============================================================ -->
    <DataTemplate x:Key="RosterCard" DataType="{x:Type m:CastMember}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top">
                    <Grid Width="130" Height="130" HorizontalAlignment="Left">
                        <Ellipse Fill="#33876A45"/>
                        <TextBlock Text="✦" FontSize="40" Foreground="{StaticResource InkFadedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SymbolFont}"/>
                        <ctl:PortraitView Source="{Binding ImagePath, Converter={StaticResource Image}, ConverterParameter=400}"
                                          OffsetX="{Binding ImageOffsetX}" OffsetY="{Binding ImageOffsetY}"
                                          CanDrag="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="3" IsHitTestVisible="False"/>
                        <Ellipse Stroke="{StaticResource InkSoftBrush}" StrokeThickness="0.8" Margin="5" Opacity="0.6" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource AddButton}" Margin="22,8,0,0" HorizontalAlignment="Left"
                            Content="Picture…"
                            Command="{Binding DataContext.ChoosePortraitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Text="Drag to reposition" FontFamily="{StaticResource BodyFont}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="2,6,0,0" Width="130" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="{Binding ImagePath, Converter={StaticResource EmptyToCollapsed}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Character name" FontFamily="{StaticResource TitleFont}" FontWeight="Bold" FontSize="24"
                             Foreground="{StaticResource RubricBrush}"/>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding CharacterSummary}" Tag="Race · Class · Level"
                             FontStyle="Italic" FontSize="16" Foreground="{StaticResource InkSoftBrush}"/>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="PLAYED BY" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBox}" Text="{Binding PlayerName}" Tag="Cast member's real name"
                                 FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Guest character: a tick box when editing, a badge when reading -->
                    <CheckBox Content="Guest character (not a regular member of the party)" IsChecked="{Binding IsGuest}" Margin="0,10,0,0"
                              Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <Border CornerRadius="9" Padding="10,2" Margin="2,10,0,0" HorizontalAlignment="Left"
                            Background="{StaticResource ArcaneBrush}">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="IsGuest"/>
                                <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource Not}"/>
                            </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="✦ GUEST CHARACTER" Foreground="#F7ECD2" FontFamily="{StaticResource HeadingFont}"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="BIO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding CharacterDescription}"
                                 Tag="The character's story: backstory, personality, look…" FontSize="16"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Appearances}" Style="{StaticResource Body}" FontSize="14" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="3,10,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource RemoveButton}" ToolTip="Remove from the campaign"
                        Command="{Binding DataContext.RemoveCastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         CHARACTERS PAGE (a campaign's characters and who plays them)
    ============================================================ -->
    <DataTemplate DataType="{x:Type m:CastRosterPage}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Campaign.DisplayName}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Characters"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <TextBlock Style="{StaticResource Body}" FontSize="16" FontStyle="Italic" Foreground="{StaticResource InkSoftBrush}"
                       Margin="2,0,0,10"
                       Text="The characters in this campaign, and who plays them. Episodes pick their cast from this list, so details written here appear on every episode they're in."/>

            <StackPanel Style="{StaticResource SectionRow}" Margin="0,4,0,12">
                <TextBlock Text="The Company" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add character"
                        Command="{Binding DataContext.AddCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Campaign}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource EmptyNote}"
                       Text="No characters yet. Press Edit Page, then + Add character."
                       Visibility="{Binding Campaign.Characters.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>

            <ItemsControl ItemsSource="{Binding Campaign.Characters}" ItemTemplate="{StaticResource RosterCard}"/>
        </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <WrapPanel/>
    </ItemsPanelTemplate>

    <!-- ============================================================
         CHARACTER CHIP (campaign and episode pages): a small portrait, the
         character and who plays them. Clicking opens the Characters page.
    ============================================================ -->
    <DataTemplate x:Key="CharacterChip" DataType="{x:Type m:CastMember}">
        <Button Style="{StaticResource LinkButton}" Margin="0,0,10,4"
                Command="{Binding DataContext.OpenRosterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="40" Margin="0,0,8,0">
                    <Ellipse Fill="#33876A45"/>
                    <ctl:PortraitView Source="{Binding ImagePath, Converter={StaticResource Image}, ConverterParameter=120}"
                                      OffsetX="{Binding ImageOffsetX, Mode=OneWay}" OffsetY="{Binding ImageOffsetY, Mode=OneWay}"/>
                    <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CharacterName}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="14"/>
                        <Border CornerRadius="7" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource ArcaneBrush}"
                                Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GUEST" Foreground="#F7ECD2" FontFamily="{StaticResource HeadingFont}" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerName}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource InkFadedBrush}"/>
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- ============================================================
         CAST PAGE (the show's real people, across every campaign)
    ============================================================ -->
    <DataTemplate x:Key="PersonCard" DataType="{x:Type m:CastMember}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top">
                    <Grid Width="130" Height="130" HorizontalAlignment="Left">
                        <Ellipse Fill="#33876A45"/>
                        <TextBlock Text="✦" FontSize="40" Foreground="{StaticResource InkFadedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource SymbolFont}"/>
                        <ctl:PortraitView Source="{Binding ImagePath, Converter={StaticResource Image}, ConverterParameter=400}"
                                          OffsetX="{Binding ImageOffsetX}" OffsetY="{Binding ImageOffsetY}"
                                          CanDrag="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Ellipse Stroke="{StaticResource GoldBrush}" StrokeThickness="3" IsHitTestVisible="False"/>
                        <Ellipse Stroke="{StaticResource InkSoftBrush}" StrokeThickness="0.8" Margin="5" Opacity="0.6" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource AddButton}" Margin="22,8,0,0" HorizontalAlignment="Left"
                            Content="Picture…"
                            Command="{Binding DataContext.ChoosePortraitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Text="Drag to reposition" FontFamily="{StaticResource BodyFont}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="2,6,0,0" Width="130" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="{Binding ImagePath, Converter={StaticResource EmptyToCollapsed}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Name" FontFamily="{StaticResource TitleFont}" FontWeight="Bold" FontSize="24"
                             Foreground="{StaticResource RubricBrush}"/>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding CharacterSummary}" Tag="Role on the show, e.g. Dungeon Master · Player · Host"
                             FontStyle="Italic" FontSize="16" Foreground="{StaticResource InkSoftBrush}"/>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="BIO" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding CharacterDescription}"
                                 Tag="About them: background, other work, what they bring to the table…" FontSize="16"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Appearances}" Style="{StaticResource Body}" FontSize="14" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="3,10,0,0"
                               Visibility="{Binding Appearances, Converter={StaticResource EmptyToCollapsed}}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource RemoveButton}" ToolTip="Remove from the cast"
                        Command="{Binding DataContext.RemoveCastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CastPageViewModel}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Main.Data.ShowName}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Cast"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <TextBlock Style="{StaticResource Body}" FontSize="16" FontStyle="Italic" Foreground="{StaticResource InkSoftBrush}"
                       Margin="2,0,0,10"
                       Text="The people who make the show, across every campaign. Dungeon Masters listed here can be picked on campaign and episode pages; guest stars can be ticked on episode pages. Each campaign's Characters page says who the cast play there."/>

            <!-- Dungeon Masters -->
            <StackPanel Style="{StaticResource SectionRow}" Margin="0,4,0,12">
                <TextBlock Text="Dungeon Masters" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add Dungeon Master" CommandParameter="DungeonMaster"
                        Command="{Binding DataContext.AddCastMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}"
                       Text="No Dungeon Masters yet. Press Edit Page, then + Add Dungeon Master."
                       Visibility="{Binding DungeonMasters.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding DungeonMasters}" ItemTemplate="{StaticResource PersonCard}"/>

            <!-- The cast -->
            <StackPanel Style="{StaticResource SectionRow}" Margin="0,10,0,12">
                <TextBlock Text="The Company" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add person" CommandParameter="Cast"
                        Command="{Binding DataContext.AddCastMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}"
                       Text="No one on the cast list yet. Press Edit Page, then + Add person."
                       Visibility="{Binding Cast.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Cast}" ItemTemplate="{StaticResource PersonCard}"/>

            <!-- Guest stars -->
            <StackPanel Style="{StaticResource SectionRow}" Margin="0,10,0,12">
                <TextBlock Text="Guest Stars" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add guest star" CommandParameter="Guest"
                        Command="{Binding DataContext.AddCastMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}"
                       Text="No guest stars yet. Press Edit Page, then + Add guest star. Tick them on the episodes they're in."
                       Visibility="{Binding Guests.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Guests}" ItemTemplate="{StaticResource PersonCard}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         SHOOT NOTES (an episode's notes from the day of filming)
    ============================================================ -->
    <DataTemplate DataType="{x:Type m:ShootNotesPage}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}">
                <Run Text="{Binding Episode.Campaign.DisplayName, Mode=OneWay}"/><Run Text="  ›  "/><Run Text="{Binding Episode.DisplayName, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageTitle}" Text="Shoot Notes"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <TextBlock Style="{StaticResource Body}" FontSize="16" FontStyle="Italic" Foreground="{StaticResource InkSoftBrush}"
                       Margin="2,0,0,12"
                       Text="What happened on the day: the moments, mishaps and surprises from filming this episode. The producer writes them here; marketing reads them to shape the go-to-market plan."/>

            <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding Episode.ShootNotes}" MinHeight="320"
                     Tag="No shoot notes yet. Press Edit Page to write some."/>

            <Button Style="{StaticResource TomeButton}" Content="← Back to the episode" HorizontalAlignment="Left" Margin="0,18,0,0"
                    Command="{Binding DataContext.CloseShootNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         EPISODE PAGE
    ============================================================ -->
    <DataTemplate DataType="{x:Type m:Episode}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Campaign.DisplayName}"/>

            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource TomeButton}" Content="✎  Shoot Notes" Margin="0" VerticalAlignment="Center"
                        ToolTip="Notes on what happened while this episode was filmed"
                        Command="{Binding DataContext.OpenShootNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="EPISODE" Style="{StaticResource FieldLabel}" FontSize="15" VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding Number}" MinWidth="44" Margin="4,0,10,0"
                             FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border CornerRadius="9" Padding="10,2" VerticalAlignment="Center"
                            Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                        <TextBlock Text="{Binding Status}" Foreground="#F7ECD2" FontFamily="{StaticResource HeadingFont}"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <TextBox Style="{StaticResource InkTitleBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="Untitled episode"/>

            <TextBlock Style="{StaticResource Flourish}"/>

            <UniformGrid Columns="2">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="DUNGEON MASTER" Style="{StaticResource FieldLabel}"/>
                    <!-- Reading: this episode's own, or the campaign's -->
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding DungeonMasterShown, Mode=OneWay}" Tag="Not set"
                             Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <TextBlock Text="from the campaign" FontFamily="{StaticResource BodyFont}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="3,0,0,0">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="IsDungeonMasterInherited"/>
                                <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource Not}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <!-- Editing: leave blank to follow the campaign -->
                    <ComboBox Style="{StaticResource TomeCombo}" IsEditable="True" Text="{Binding DungeonMaster, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding DataContext.Data.DungeonMasters, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="PlayerName" TextSearch.TextPath="PlayerName"
                              ToolTip="Pick a Dungeon Master from the Cast page, or type a name. Leave blank to use the campaign's."/>
                    <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource InkFadedBrush}" Margin="3,2,0,0" TextWrapping="Wrap">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="Campaign.DungeonMaster" Converter="{StaticResource NotEmpty}"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                        <Run Text="Blank means the campaign's Dungeon Master,"/> <Run Text="{Binding Campaign.DungeonMaster, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="DATE FILMED" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Style="{StaticResource ViewOnlyBody}" Text="{Binding DateFilmed, Converter={StaticResource DateText}}"/>
                    <DatePicker Style="{StaticResource TomeDatePicker}" SelectedDate="{Binding DateFilmed}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="RUNTIME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding Runtime}" Tag="e.g. 1:42:30"/>
                </StackPanel>
            </UniformGrid>

            <!-- Synopsis -->
            <TextBlock Text="Synopsis" Style="{StaticResource SectionHeader}" Margin="0,8,0,6"/>
            <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding Synopsis}" Tag="No synopsis yet."/>

            <!-- Cast -->
            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="The Adventuring Party" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource TomeButton}" Content="Characters →" Margin="14,0,0,0" FontSize="11" Padding="8,3"
                        ToolTip="Edit the campaign's characters and who plays them"
                        Command="{Binding DataContext.OpenRosterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Campaign}"/>
            </StackPanel>

            <!-- Edit mode: tick who's in this episode -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Border.Visibility>
                    <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource BoolToVis}"/>
                </Border.Visibility>
                <StackPanel>
                    <TextBlock Text="WHO'S AT THE TABLE THIS EPISODE?" Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                    <TextBlock Style="{StaticResource EmptyNote}"
                               Text="This campaign has no characters yet. Add them on the Characters page."
                               Visibility="{Binding HasCampaignCharacters, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <ItemsControl ItemsSource="{Binding CastChoices}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:CastChoice}">
                                <CheckBox IsChecked="{Binding IsInEpisode}" Margin="0,0,22,6">
                                    <TextBlock>
                                        <Run Text="{Binding Member.CharacterName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Member.PlayerName, Mode=OneWay}" FontStyle="Italic"
                                             Foreground="{StaticResource InkFadedBrush}"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource EmptyNote}" Text="No cast chosen for this episode yet."
                       Visibility="{Binding CastMembers.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding CastMembers}" ItemTemplate="{StaticResource CharacterChip}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>

            <!-- Guest stars: picked from the Cast page. The whole section is left out when there are none (unless editing). -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="{Binding GuestCount, Converter={StaticResource EmptyToCollapsed}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Guest Stars" Style="{StaticResource SectionHeader}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Border.Visibility>
                    <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource BoolToVis}"/>
                </Border.Visibility>
                <StackPanel>
                    <TextBlock Text="WHO'S GUESTING THIS EPISODE?" Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                    <TextBlock Style="{StaticResource EmptyNote}"
                               Text="No guest stars on the Cast page yet. Add them there, then tick them here."
                               Visibility="{Binding HasShowGuests, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <ItemsControl ItemsSource="{Binding GuestChoices}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:GuestChoice}">
                                <CheckBox IsChecked="{Binding IsInEpisode}" Margin="0,0,22,6">
                                    <TextBlock>
                                        <Run Text="{Binding Member.PlayerName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Member.CharacterSummary, Mode=OneWay}" FontStyle="Italic"
                                             Foreground="{StaticResource InkFadedBrush}"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource EmptyNote}" Text="No guest stars."
                       Visibility="{Binding GuestCount, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Guests}" ItemTemplate="{StaticResource GuestCard}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>
            <!-- Guests written straight onto this episode by earlier versions -->
            <ItemsControl ItemsSource="{Binding GuestCast}" ItemTemplate="{StaticResource CastCard}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>
            </StackPanel>

            <!-- Key moments -->
            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Key Moments" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add moment"
                        Command="{Binding DataContext.AddKeyMomentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}" Text="No key moments recorded."
                       Visibility="{Binding KeyMoments.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding KeyMoments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:KeyMoment}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✧" Foreground="{StaticResource GoldBrush}" FontSize="16" Margin="0,3,0,0"
                                       FontFamily="{StaticResource SymbolFont}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InkBox}" Text="{Binding Timestamp}" Tag="Time"
                                     FontFamily="{StaticResource HeadingFont}" FontSize="14" FontWeight="Bold"
                                     Foreground="{StaticResource InkSoftBrush}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="2" Style="{StaticResource InkBoxMulti}" Text="{Binding Description}" Tag="What happened?"/>
                            <Button Grid.Column="3" Style="{StaticResource RemoveButton}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveKeyMomentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Air dates -->
            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Air Dates" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource AddButton}" Content="+ Add air date"
                        Command="{Binding DataContext.AddAirDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}" Text="No air dates set."
                       Visibility="{Binding AirDates.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding AirDates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:AirDate}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☾" Foreground="{StaticResource GoldBrush}" FontSize="16" Margin="0,2,0,0"
                                       FontFamily="{StaticResource SymbolFont}"/>
                            <Grid Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource ViewOnlyBody}" FontWeight="SemiBold"
                                           Text="{Binding Date, Converter={StaticResource DateText}}"/>
                                <DatePicker Style="{StaticResource TomeDatePicker}" SelectedDate="{Binding Date}"/>
                            </Grid>

                            <!-- Platforms: text when reading; a tick-list drop-down when editing -->
                            <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource ViewOnlyBody}" Text="{Binding Platform}"/>
                                <ToggleButton x:Name="PlatformToggle">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource TomePicker}">
                                            <Style.Triggers>
                                                <!-- While the list is open, a click on the field only closes it (instead of closing and reopening) -->
                                                <DataTrigger Binding="{Binding IsOpen, ElementName=PlatformPopup}" Value="True">
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding Platform}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Choose platforms…" Foreground="{StaticResource InkFadedBrush}" FontStyle="Italic"
                                                   Visibility="{Binding Platform, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
                                    </Grid>
                                </ToggleButton>
                                <Popup x:Name="PlatformPopup" PlacementTarget="{Binding ElementName=PlatformToggle}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True"
                                       IsOpen="{Binding IsChecked, ElementName=PlatformToggle, Mode=TwoWay}">
                                    <Border Background="#F7ECD2" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="12,8" Margin="0,2,10,10" MinWidth="190">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ItemsControl ItemsSource="{Binding PlatformChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:PlatformChoice}">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBox Grid.Column="3" Style="{StaticResource InkBox}" Text="{Binding Notes}" Tag="Notes"
                                     Foreground="{StaticResource InkSoftBrush}" FontStyle="Italic" VerticalAlignment="Top"/>

                            <!-- Link: a button when reading; the web address when editing -->
                            <Grid Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource TomeButton}" Content="Link ↗" FontSize="11" Padding="8,3" Margin="0"
                                        ToolTip="{Binding Link}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Link}">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                            <Binding Path="Link" Converter="{StaticResource NotEmpty}"/>
                                            <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}" Converter="{StaticResource Not}"/>
                                        </MultiBinding>
                                    </Button.Visibility>
                                </Button>
                                <TextBox Style="{StaticResource InkBox}" Text="{Binding Link}" Tag="Link (https://…)" Width="220" TextWrapping="NoWrap"
                                         Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <Button Grid.Column="5" Style="{StaticResource RemoveButton}" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveAirDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Production notes -->
            <TextBlock Text="Production Notes" Style="{StaticResource SectionHeader}" Margin="0,18,0,6"/>
            <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding ProductionNotes}"
                     Tag="Planning notes, props, reminders, schedule changes…"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         CAMPAIGN PAGE
    ============================================================ -->
    <DataTemplate DataType="{x:Type m:Campaign}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Season.DisplayName}"/>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="CAMPAIGN" Style="{StaticResource FieldLabel}" FontSize="15" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource InkBox}" Text="{Binding Number}" MinWidth="30" Margin="4,0,0,0"
                         FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox Style="{StaticResource InkTitleBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Tag="Untitled campaign"/>

            <TextBlock Style="{StaticResource Flourish}"/>

            <!-- The campaign's details on the left; the book it's played from (cover art, then title) on the right -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Columns="2" VerticalAlignment="Top">
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="DUNGEON MASTER" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBox}" Text="{Binding DungeonMaster}" Tag="Not set"
                                 Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <ComboBox Style="{StaticResource TomeCombo}" IsEditable="True" Text="{Binding DungeonMaster, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding DataContext.Data.DungeonMasters, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="PlayerName" TextSearch.TextPath="PlayerName"
                                  ToolTip="Pick a Dungeon Master from the Cast page, or type a name"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="SETTING / GAME SYSTEM" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBox}" Text="{Binding Setting}" Tag="e.g. D&amp;D 5e, Warcraft"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="FILMING STARTS" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource ViewOnlyBody}" Text="{Binding FilmingStart, Converter={StaticResource DateText}}"/>
                        <DatePicker Style="{StaticResource TomeDatePicker}" SelectedDate="{Binding FilmingStart}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="FILMING ENDS" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource ViewOnlyBody}" Text="{Binding FilmingEnd, Converter={StaticResource DateText}}"/>
                        <DatePicker Style="{StaticResource TomeDatePicker}" SelectedDate="{Binding FilmingEnd}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="FILMING LOCATION" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InkBox}" Text="{Binding FilmingLocation}" Tag="Not set"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Column="1" Width="300" Margin="28,0,0,14" VerticalAlignment="Top">
                    <!-- Cover art in a gilt picture frame -->
                    <Border CornerRadius="3" BorderBrush="{StaticResource GoldBrush}" BorderThickness="4" Padding="5" Background="#3A2412"
                            HorizontalAlignment="Center"
                            Visibility="{Binding CoverImage, Converter={StaticResource EmptyToCollapsed}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="300" Opacity="0.55"/>
                        </Border.Effect>
                        <Border BorderBrush="{StaticResource GoldLightBrush}" BorderThickness="1" Padding="4" Background="#1E1008">
                            <Border BorderBrush="#66000000" BorderThickness="1">
                                <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=900}" Stretch="Uniform"
                                       MaxHeight="400" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Border>
                    </Border>
                    <!-- Edit mode: where the cover art goes, until some is chosen -->
                    <Grid Height="380">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="{Binding CoverImage, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle RadiusX="6" RadiusY="6" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="#1A876A45"/>
                        <TextBlock Text="Cover art" FontFamily="{StaticResource BodyFont}" FontSize="15" FontStyle="Italic"
                                   Foreground="{StaticResource InkFadedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource AddButton}" Content="Choose cover art…" Margin="0"
                                Command="{Binding DataContext.ChooseCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource AddButton}" Content="Remove" Margin="6,0,0,0"
                                Command="{Binding DataContext.RemoveCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                    <Binding Path="DataContext.IsEditing" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="CoverImage" Converter="{StaticResource NotEmpty}"/>
                                </MultiBinding>
                            </Button.Visibility>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="BOOK TITLE" Style="{StaticResource FieldLabel}" Margin="2,10,0,1"/>
                    <TextBox Style="{StaticResource InkBox}" Text="{Binding BookTitle, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Not set" FontFamily="{StaticResource HeadingFont}" FontSize="16" Foreground="{StaticResource InkSoftBrush}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="About this Campaign" Style="{StaticResource SectionHeader}" Margin="0,8,0,6"/>
            <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding Description}" Tag="No description yet."/>

            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Characters" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource TomeButton}" Content="Open →" Margin="14,0,0,0" FontSize="11" Padding="8,3"
                        Command="{Binding DataContext.OpenRosterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}" Text="No characters yet."
                       Visibility="{Binding Characters.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Characters}" ItemTemplate="{StaticResource CharacterChip}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>

            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Episodes" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource TomeButton}" Content="+ New episode" Margin="14,0,0,0" FontSize="11" Padding="8,3"
                        Command="{Binding DataContext.AddEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource EmptyNote}" Text="No episodes yet."
                       Visibility="{Binding Episodes.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>

            <Grid Margin="6,0,6,4" Visibility="{Binding Episodes.Count, Converter={StaticResource EmptyToCollapsed}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="NO." Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="FILMED" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="FIRST AIRED" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource FieldLabel}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Episodes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Episode}">
                        <Button Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" FontSize="15" Text="{Binding DateFilmed, Converter={StaticResource DateText}, ConverterParameter='MMM d, yyyy'}"/>
                                <TextBlock Grid.Column="3" FontSize="15" Text="{Binding FirstAirDate, Converter={StaticResource DateText}, ConverterParameter='MMM d, yyyy'}"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="15"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         SEASON PAGE
    ============================================================ -->
    <DataTemplate DataType="{x:Type m:Season}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="Dungeon Masters"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Season" Style="{StaticResource PageTitle}"/>
                <TextBox Style="{StaticResource InkTitleBox}" Text="{Binding Number}" MinWidth="40" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBox Style="{StaticResource InkBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Season title (optional)" FontFamily="{StaticResource HeadingFont}" FontSize="20"
                     Foreground="{StaticResource InkSoftBrush}"/>

            <TextBlock Style="{StaticResource Flourish}"/>

            <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="YEAR" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource InkBox}" Text="{Binding Year}" Tag="Not set" HorizontalAlignment="Left" MinWidth="120"/>
            </StackPanel>

            <TextBlock Text="About this Season" Style="{StaticResource SectionHeader}" Margin="0,8,0,6"/>
            <TextBox Style="{StaticResource InkBoxMulti}" Text="{Binding Description}" Tag="No description yet."/>

            <StackPanel Style="{StaticResource SectionRow}">
                <TextBlock Text="Campaigns" Style="{StaticResource SectionHeader}"/>
                <Button Style="{StaticResource TomeButton}" Content="+ New campaign" Margin="14,0,0,0" FontSize="11" Padding="8,3"
                        Command="{Binding DataContext.AddCampaignCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyNote}" Text="No campaigns yet."
                       Visibility="{Binding Campaigns.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Campaigns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Campaign}">
                        <Button Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontStyle="Italic" Foreground="{StaticResource InkFadedBrush}">
                                    <Run Text="{Binding Episodes.Count, Mode=OneWay}"/><Run Text=" episodes"/>
                                </TextBlock>
                                <TextBlock Text="⚔" FontFamily="{StaticResource SymbolFont}" Foreground="{StaticResource GoldBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="16"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         SCHEDULE EVENT ROW (Chronicle + Prologue)
    ============================================================ -->
    <DataTemplate x:Key="EventRow" DataType="{x:Type vm:ScheduleEvent}">
        <Button x:Name="Row" Style="{StaticResource LinkButton}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding Target}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Day}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="24"
                               HorizontalAlignment="Center" Foreground="{StaticResource RubricBrush}"/>
                    <TextBlock Text="{Binding Weekday}" FontSize="12" HorizontalAlignment="Center" Margin="0,-4,0,0"
                               FontFamily="{StaticResource HeadingFont}" Foreground="{StaticResource InkFadedBrush}"/>
                </StackPanel>
                <Border x:Name="Badge" Grid.Column="1" CornerRadius="9" Padding="8,2" Margin="6,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Background="#4F7F3A">
                    <TextBlock x:Name="BadgeText" Text="☾ AIRING" Foreground="#F7ECD2" FontSize="11" FontWeight="Bold"
                               FontFamily="{StaticResource HeadingFont}"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subline}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource InkFadedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFilming}" Value="True">
                <Setter TargetName="Badge" Property="Background" Value="{StaticResource ArcaneBrush}"/>
                <Setter TargetName="BadgeText" Property="Text" Value="✦ FILMING"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPast}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#33C9A24A"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         CHRONICLE OF DATES (schedule)
    ============================================================ -->
    <DataTemplate x:Key="NextCard" DataType="{x:Type vm:ScheduleEvent}">
        <Button Style="{StaticResource LinkButton}"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding Target}">
            <StackPanel>
                <TextBlock Text="{Binding LongDate}"
                           FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource RubricBrush}"/>
                <TextBlock Text="{Binding Heading}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CampaignName}" FontSize="15" FontStyle="Italic" Foreground="{StaticResource InkFadedBrush}"/>
                <TextBlock Text="{Binding Where}" FontSize="15" Foreground="{StaticResource InkFadedBrush}"
                           Visibility="{Binding Where, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="Filming schedule &amp; air dates"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Chronicle of Dates"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <WrapPanel Margin="0,0,0,14">
                <ComboBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding SelectedCampaign}" DisplayMemberPath="Name"
                          MinWidth="240" Margin="0,0,20,6" FontFamily="{StaticResource BodyFont}" FontSize="15"/>
                <CheckBox Content="Filming" IsChecked="{Binding ShowFilming}" Margin="0,0,16,6"/>
                <CheckBox Content="Air dates" IsChecked="{Binding ShowAiring}" Margin="0,0,16,6"/>
                <CheckBox Content="Show past dates" IsChecked="{Binding ShowPast}" Margin="0,0,16,6"/>
            </WrapPanel>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="✦ NEXT FILMING" Style="{StaticResource FieldLabel}" Foreground="{StaticResource ArcaneBrush}"/>
                        <ContentControl Content="{Binding NextFilming}" ContentTemplate="{StaticResource NextCard}"
                                        Visibility="{Binding NextFilming, Converter={StaticResource EmptyToCollapsed}}"/>
                        <TextBlock Style="{StaticResource EmptyNote}" Text="Nothing scheduled."
                                   Visibility="{Binding NextFilming, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="☾ NEXT AIRING" Style="{StaticResource FieldLabel}" Foreground="#4F7F3A"/>
                        <ContentControl Content="{Binding NextAiring}" ContentTemplate="{StaticResource NextCard}"
                                        Visibility="{Binding NextAiring, Converter={StaticResource EmptyToCollapsed}}"/>
                        <TextBlock Style="{StaticResource EmptyNote}" Text="Nothing scheduled."
                                   Visibility="{Binding NextAiring, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource EmptyNote}" Margin="2,12,0,0"
                       Text="No dates to show. Add a filming date or air dates on an episode's page, or tick 'Show past dates'."
                       Visibility="{Binding Months.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>

            <ItemsControl ItemsSource="{Binding Months}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MonthGroup}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}"/>
                            <Rectangle Height="1" Fill="{StaticResource GoldBrush}" Margin="0,4,0,6" Opacity="0.7"/>
                            <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventRow}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding Unscheduled.Count, Converter={StaticResource EmptyToCollapsed}}">
                <TextBlock Text="Not Yet Scheduled" Style="{StaticResource SectionHeader}" Margin="0,22,0,0"/>
                <Rectangle Height="1" Fill="{StaticResource GoldBrush}" Margin="0,4,0,6" Opacity="0.7"/>
                <ItemsControl ItemsSource="{Binding Unscheduled}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Episode}">
                            <Button Style="{StaticResource LinkButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                    <Run Text="{Binding Campaign.DisplayName, Mode=OneWay}" FontStyle="Italic" FontSize="14"
                                         Foreground="{StaticResource InkFadedBrush}"/>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         PROLOGUE (home page)
    ============================================================ -->
    <DataTemplate DataType="{x:Type vm:PrologueViewModel}">
        <StackPanel Margin="4,10,12,30">
            <Image Source="{StaticResource DmapLogo}" Width="460" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.35"/>
                </Image.Effect>
            </Image>
            <TextBlock Text="The Production Guide" FontFamily="{StaticResource TitleFont}" FontWeight="Bold" FontSize="26"
                       Foreground="{StaticResource RubricBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <UniformGrid Columns="3" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SeasonCount}" FontFamily="{StaticResource TitleFont}" FontSize="38" FontWeight="Bold"
                               Foreground="{StaticResource RubricBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="SEASONS" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CampaignCount}" FontFamily="{StaticResource TitleFont}" FontSize="38" FontWeight="Bold"
                               Foreground="{StaticResource RubricBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="CAMPAIGNS" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding EpisodeCount}" FontFamily="{StaticResource TitleFont}" FontSize="38" FontWeight="Bold"
                               Foreground="{StaticResource RubricBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="EPISODES" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="⚔ CURRENT CAMPAIGN" Style="{StaticResource FieldLabel}"/>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding CurrentCampaign.DisplayName}"
                                FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding CurrentCampaign}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="✧ LATEST EPISODE" Style="{StaticResource FieldLabel}"/>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding LatestEpisode.DisplayName}"
                                FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding LatestEpisode}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Coming Up" Style="{StaticResource SectionHeader}" Margin="0,16,0,0"/>
            <Rectangle Height="1" Fill="{StaticResource GoldBrush}" Margin="0,4,0,6" Opacity="0.7"/>
            <TextBlock Style="{StaticResource EmptyNote}"
                       Text="No upcoming dates yet. Add filming and air dates on episode pages and they'll appear here."
                       Visibility="{Binding Upcoming.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=Invert}"/>
            <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource EventRow}"/>

            <TextBlock Text="Using this Tome" Style="{StaticResource SectionHeader}" Margin="0,20,0,0"/>
            <Rectangle Height="1" Fill="{StaticResource GoldBrush}" Margin="0,4,0,8" Opacity="0.7"/>
            <TextBlock Style="{StaticResource Body}" FontSize="16">
                <Run Text="Choose a season, campaign or episode from the Table of Contents to open its page. "/>
                <Run Text="Press" /><Run Text=" Edit Page " FontWeight="Bold"/><Run Text="to write in the tome; press"/>
                <Run Text=" Done " FontWeight="Bold"/><Run Text="to seal your changes. New episodes copy the cast and Dungeon Master from the previous episode."/>
            </TextBlock>

            <TextBlock Margin="0,18,0,0" FontSize="14" Style="{StaticResource Body}" Foreground="{StaticResource InkFadedBrush}" FontStyle="Italic"
                       Text="{Binding LocationText}"/>
            <Button Style="{StaticResource TomeButton}" Content="Settings…" HorizontalAlignment="Left" Margin="0,6,0,0"
                    FontSize="11" Padding="8,3" ToolTip="Your name, and where the guide is kept"
                    Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         SETTINGS: your name, and where the guide lives
    ============================================================ -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="Where the guide lives"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings"/>
            <TextBlock Style="{StaticResource Flourish}"/>

            <StackPanel Style="{StaticResource Field}">
                <TextBlock Text="YOUR NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FormBox}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Tag="Your name" MaxWidth="420" HorizontalAlignment="Left" MinWidth="300"/>
                <TextBlock Style="{StaticResource EmptyNote}" Text="Shown to other people on the pages you change."/>
            </StackPanel>

            <TextBlock Text="The Guide" Style="{StaticResource SectionHeader}" Margin="0,8,0,8"/>
            <StackPanel Visibility="{Binding CanChooseWhere, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                <RadioButton GroupName="Where" IsChecked="{Binding UseServer}" Content="The shared guide server" Margin="0,0,0,4"/>
                <RadioButton GroupName="Where" IsChecked="{Binding UseFolder}" Content="A folder on this computer (e.g. a shared OneDrive folder)"/>
            </StackPanel>

            <StackPanel Visibility="{Binding UseServer, Converter={StaticResource BoolToVis}}">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="SERVER ADDRESS" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource FormBox}" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Tag="e.g. https://name.tailnet.ts.net/" MaxWidth="520" MinWidth="380" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="ACCESS KEY" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox svc:PasswordBoxHelper.BoundPassword="{Binding AccessKey, Mode=TwoWay}" Style="{StaticResource FormPassword}"
                                 MaxWidth="520" MinWidth="380" HorizontalAlignment="Left"
                                 Visibility="{Binding ShowKey, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <TextBox Style="{StaticResource FormBox}" Text="{Binding AccessKey, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" MaxWidth="520" MinWidth="380" HorizontalAlignment="Left"
                             Visibility="{Binding ShowKey, Converter={StaticResource BoolToVis}}"/>
                    <CheckBox Content="Show key" IsChecked="{Binding ShowKey}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource EmptyNote}"
                           Text="Ask the person who runs the shared guide for its address and access key."/>
            </StackPanel>

            <StackPanel Visibility="{Binding UseFolder, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Body}" FontSize="16" TextWrapping="Wrap">
                    <Run Text="Kept in"/> <Run Text="{Binding DataFolder, Mode=OneWay}" FontStyle="Italic"/>
                </TextBlock>
                <TextBlock Style="{StaticResource EmptyNote}"
                           Text="The guide lives beside the app in the shared folder, so everyone who opens the app from there sees the same guide. Who can change it is set by the folder's sharing permissions."
                           Visibility="{Binding FolderIsFixed, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource TomeButton}" Content="Choose folder…" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}"
                        Visibility="{Binding FolderIsFixed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        ToolTip="Move the guide to a shared folder (e.g. OneDrive) so the team can use it, or open one that's already there"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Body}" FontSize="16" Foreground="{StaticResource RubricBrush}" Margin="2,14,0,0"
                       Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource EmptyToCollapsed}}"/>

            <TextBlock Style="{StaticResource Body}" FontSize="14" Foreground="{StaticResource InkFadedBrush}" FontStyle="Italic" Margin="2,24,0,0"
                       Text="{Binding VersionText, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource Body}" FontSize="14" Foreground="{StaticResource RubricBrush}" Margin="2,4,0,0" TextWrapping="Wrap"
                       Text="{Binding Main.VersionWarning}" Visibility="{Binding Main.VersionWarning, Converter={StaticResource EmptyToCollapsed}}"/>

            <Button Style="{StaticResource TomeButton}" Content="Use these settings" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding ApplyCommand}" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ============================================================
         THE GUIDE COULDN'T BE OPENED
    ============================================================ -->
    <DataTemplate DataType="{x:Type vm:GuideUnavailablePage}">
        <StackPanel Margin="4,0,12,30">
            <TextBlock Style="{StaticResource PageKicker}" Text="The shared guide"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource Flourish}"/>
            <TextBlock Style="{StaticResource Body}" Text="{Binding Message}"/>
            <WrapPanel Margin="0,18,0,0">
                <Button Style="{StaticResource TomeButton}" Content="Try again" Command="{Binding Main.ReconnectCommand}"/>
                <Button Style="{StaticResource TomeButton}" Content="Settings…" Command="{Binding Main.ShowSettingsCommand}"
                        Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
